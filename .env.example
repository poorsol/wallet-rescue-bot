# ==============================================================================
# WALLET RESCUE BOT - KONFIGURASI (.env)
# ==============================================================================
# PENTING:
# 1. Copy file ini menjadi ".env" (tanpa .example)
# 2. JANGAN PERNAH share file .env atau upload ke GitHub / cloud!
# 3. Semua private key hanya dipakai lokal di komputer kamu.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ETHEREUM MAINNET (EIP-7702 Revoke + Private MEV Bundle)
# ------------------------------------------------------------------------------
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# Private key wallet AMAN yang punya sedikit ETH untuk bayar gas (sponsor)
# Format: 0x... (64 hex chars setelah 0x)
ETH_SPONSOR_PRIVATE_KEY=

# Private key wallet KORBAN yang kena drain/sweeper
ETH_VICTIM_PRIVATE_KEY=

# Alamat wallet AMAN tujuan pengiriman aset
ETH_SAFE_RECIPIENT=

# Priority fee (tip gas ke builder) dalam Gwei. Naikkan (mis. 2-5) jika jaringan padat
ETH_PRIORITY_FEE_GWEI=1.5

# Buffer penggali baseFee (mis. 1.3 = 130% dari baseFee saat ini)
ETH_BASE_FEE_MULTIPLIER=1.35

# Jumlah blok berturut-turut yang dicoba dikirim ke MEV builders
ETH_TARGET_BLOCK_ATTEMPTS=15

# Opsional: Private key random baru untuk tanda tangan header X-Flashbots-Signature
# Jika kosong, bot akan generate key sementara otomatis setiap dijalankan
ETH_FLASHBOTS_AUTH_KEY=

# Daftar endpoint MEV Builder (dipisahkan koma)
ETH_MEV_BUILDERS=https://rpc.titanbuilder.xyz,https://relay.flashbots.net,https://rpc.beaverbuild.org,https://rsync-builder.xyz

# ------------------------------------------------------------------------------
# 2. SOLANA (Sponsored Fee Payer + Atomic Jito Bundle)
# ------------------------------------------------------------------------------
SOL_RPC_URL=https://api.mainnet-beta.solana.com

# Private key wallet AMAN (sponsor bayar gas & Jito tip).
# Mendukung format Base58 (Phantom/Solflare export) atau JSON array [12,34,...]
SOL_SPONSOR_PRIVATE_KEY=

# Private key wallet KORBAN
SOL_VICTIM_PRIVATE_KEY=

# Alamat wallet AMAN tujuan pengiriman SOL / SPL Token
SOL_SAFE_RECIPIENT=

# Tip ke Jito Block Engine dalam lamports (default: 100000 = 0.0001 SOL)
SOL_JITO_TIP_LAMPORTS=100000

# Jito Block Engine endpoints (dipisahkan koma)
SOL_JITO_ENDPOINTS=https://mainnet.block-engine.jito.wtf/api/v1/bundles,https://ny.mainnet.block-engine.jito.wtf/api/v1/bundles,https://amsterdam.mainnet.block-engine.jito.wtf/api/v1/bundles,https://tokyo.mainnet.block-engine.jito.wtf/api/v1/bundles

# ------------------------------------------------------------------------------
# 3. TRON (Permission Check + Stake 2.0 Energy/Bandwidth Delegated TRC-20 Rescue)
# ------------------------------------------------------------------------------
TRX_FULL_HOST=https://api.trongrid.io

# Opsional: API key gratis dari https://www.trongrid.io agar tidak kena rate-limit
TRX_TRONGRID_API_KEY=

# Private key wallet AMAN (sponsor yang punya Staked TRX untuk delegate Energy/Bandwidth)
# Format: 64 hex chars (tanpa 0x)
TRX_SPONSOR_PRIVATE_KEY=

# Private key wallet KORBAN
TRX_VICTIM_PRIVATE_KEY=

# Alamat wallet AMAN tujuan pengiriman TRC-20 (format T...)
TRX_SAFE_RECIPIENT=

# Default kontrak USDT TRC-20 Mainnet
TRX_DEFAULT_TOKEN=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# Opsional: Node broadcast tambahan (dipisahkan koma) untuk mempercepat trx:relay
TRX_EXTRA_BROADCAST_NODES=
